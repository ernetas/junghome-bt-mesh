# App backup with live mesh keys (NetKey/AppKey/DevKeys) — never commit
ios/
# The downloaded APK, its decompile output and any notes or export next to them — never commit (redistributable? no)
/android/
__pycache__/
.venv/
dist/
build/
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
.nox/
*.egg-info/
# The CLI's per-address sequence counters (+ their .lock / .bak / temp siblings) and the device keys `provision`
# writes — never commit, never share
tools/.jhmesh_state*
tools/.jhmesh_devkey*
# the temporary file an atomic write renames into place (`.<name>.<pid>.<thread>.tmp`), and any other temp file
tools/..jhmesh_*
*.tmp
# the assistant's local settings and worktrees
/.claude/
# What the docs tell you to create in the repository root, and the same anywhere else (an export saved under docs/,
# say): app exports (every mesh key), decoded captures (a day of decrypted household traffic), hop matrices, `tee`
# logs, editor/HA backup copies. The synthetic exports under tests/fixtures/ are the one exception.
**/JungHome*.json
**/MeshNetwork*.json
!/tests/fixtures/**/JungHome*.json
!/tests/fixtures/**/MeshNetwork*.json
*.bak
/hops.json
*.ndjson
*.pcap
*.pcapng
capture-*.log
.hypothesis/
# replay traces (tests/traces/, tools/trace_to_fixture.py): synthetic or converted and reviewed by hand
!/tests/traces/*.ndjson
# mutmut's working copy (pyproject.toml `[tool.mutmut]`, nightly.yml `mutation`)
/mutants/
